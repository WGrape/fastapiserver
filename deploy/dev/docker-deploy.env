# =============================================================================
# 开发环境配置
# =============================================================================

# 运行环境
ENVIRONMENT=dev

# 监听地址和端口
HOST=0.0.0.0
PORT=8000

# Worker 配置（开发环境只需要 1 个 worker）
WORKERS=1
WORKER_CONNECTIONS=1000

# 日志级别（开发环境用 debug）
LOG_LEVEL=debug

# 不预加载代码，支持热更新
PRELOAD_APP=false

# 超时配置
TIMEOUT=120
KEEPALIVE=5
GRACEFUL_TIMEOUT=30

# Worker 重启配置
MAX_REQUESTS=10000
MAX_REQUESTS_JITTER=1000

# Worker 临时目录 - macOS 用 /tmp，Linux 可以用 /dev/shm
WORKER_TMP_DIR=/tmp
