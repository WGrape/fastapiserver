# =============================================================================
# 生产环境配置
# =============================================================================

# 运行环境
ENVIRONMENT=prod

# 监听地址和端口
HOST=0.0.0.0
PORT=8000

# Worker 配置（生产环境用 4 个 worker）
WORKERS=4
WORKER_CONNECTIONS=1000

# 日志级别
LOG_LEVEL=info

# 预加载代码
PRELOAD_APP=true

# 超时配置
TIMEOUT=120
KEEPALIVE=5
GRACEFUL_TIMEOUT=30

# Worker 重启配置
MAX_REQUESTS=10000
MAX_REQUESTS_JITTER=1000
